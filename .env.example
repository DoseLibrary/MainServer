DOSE_PORT=3000
# Image tag to run: latest (default), a release like 1.2.3, or sha-<commit>.
DOSE_VERSION=latest
DOSE_MOVIES_PATH=D:/Media/Movies
DOSE_SHOWS_PATH=D:/Media/Shows
POSTGRES_DB=dose
POSTGRES_USER=dose
# Use only letters, numbers, underscores, and hyphens.
POSTGRES_PASSWORD=replace-with-a-long-unique-password
# Free TMDB API read-access token used during scans for metadata and artwork.
TMDB_API_TOKEN=
